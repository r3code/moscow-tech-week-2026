{
  "name": "mtw2026-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moscow Tech Week 2026 deck — ClickHouse + Vector, 3x cheaper log storage. Slidev sources.",
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "gen:pagemap": "python3 scripts/build_page_map.py",
    "predev": "npm run gen:version",
    "dev": "slidev --open false",
    "prebuild": "npm run gen:version",
    "build": "slidev build",
    "preexport:pdf": "npm run gen:version",
    "export:pdf": "slidev export --format pdf --with-clicks --output ../exported/MoscowTechWeek2026_ClickHouse_Vector.pdf",
    "preexport:pptx": "npm run gen:version",
    "export:pptx": "slidev export --format pptx --with-clicks --output ../exported/MoscowTechWeek2026_ClickHouse_Vector.pptx",
    "preexport:png": "npm run gen:version",
    "export:png": "slidev export --format png --with-clicks --output qa"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/pt-serif": "5.3.0",
    "@fortawesome/fontawesome-free": "6.5.1",
    "@slidev/cli": "53.1.0",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "1.57.0"
  }
}
